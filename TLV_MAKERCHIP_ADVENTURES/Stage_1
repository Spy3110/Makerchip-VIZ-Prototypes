\m5_TLV_version 1d: tl-x.org
\m5
   /*WELCOME to the Land of TL-Verilog!
   To pass the first stage, you have to solve this challege
   to prove your one brain cell. 
   
   🚦 STAGE 1: THE POSSESSED TRAFFIC LIGHT
   
   Something is wrong with this traffic light.
   Watch the VIZ carefully...Don't just stare! 
   Does the sequence look right to you?
   Green → Yellow → Red → Green?
   
   Find the bug. Fix it. 
   The citizens are waiting!
   */

\SV
   m5_makerchip_module
\TLV
   $reset = *reset;
   $green_dur[7:0]  = 8'd8;
   $yellow_dur[7:0] = 8'd3;
   $red_dur[7:0]    = 8'd5;

   $next_state[1:0] = 
      ($timer == 8'd0) ? 
         ( ($state == 2'd0) ? 2'd1 :
           ($state == 2'd1) ? 2'd0 :
           2'd0 ) :
      $state;

   $next_timer[7:0] = 
      ($timer == 8'd0) ? 
         ( ($state == 2'd0) ? $yellow_dur :
           ($state == 2'd1) ? $red_dur :
           $green_dur ) :
      $timer - 8'd1;

   $state[1:0] = $reset ? 2'd0 : >>1$next_state;
   $timer[7:0] = $reset ? $green_dur : >>1$next_timer;

   $green  = ($state == 2'd0);
   $yellow = ($state == 2'd1);
   $red    = ($state == 2'd2);

   \viz_js //Dont touch this unless you like pain
      box: {left: 0, top: 0, width: 80, height: 220, fill: "#222222", rx: 10, ry: 10},
      
      template: {
         red_light:    ["Circle", {left: 15, top: 15, radius: 25, fill: "#440000"}],
         yellow_light: ["Circle", {left: 15, top: 85, radius: 25, fill: "#444400"}],
         green_light:  ["Circle", {left: 15, top: 155, radius: 25, fill: "#004400"}]
      },
      
      render() {
         let r = '$red'.asBool();
         let y = '$yellow'.asBool();
         let g = '$green'.asBool();
         
         this.getObjects().red_light.set({fill: r ? "#FF3333" : "#440000"});
         this.getObjects().yellow_light.set({fill: y ? "#FFFF33" : "#444400"});
         this.getObjects().green_light.set({fill: g ? "#33FF33" : "#004400"});
      },
      
      where: {left: 20, top: 20, width: 80, height: 220}
      
   *passed = *cyc_cnt > 100;
   *failed = 1'b0;
\SV
   endmodule
